# FYERS API credentials (optional).
# The ML backend works fully OFFLINE without these — it falls back to seeded
# historical data + realistic mock quotes for every NIFTY 50 ticker, so
# /predict/{ticker} and /api/market/nifty50 work out of the box for demos.
#
# FYERS API credentials (server-side only, never exposed to frontend).
# Fill these in for automatic headless TOTP daily authentication:
FYERS_APP_ID=
FYERS_SECRET_KEY=
FYERS_CLIENT_ID=
FYERS_PIN=
FYERS_TOTP_KEY=
FYERS_REDIRECT_URL=http://127.0.0.1:8000/fyers/callback
FYERS_ACCESS_TOKEN=
FYERS_REFRESH_TOKEN=

# PostgreSQL Database Configuration for User Profile & Trade History
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nifty_trader_db

